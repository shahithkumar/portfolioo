{
    "version": 2,
    "builds": [
        {
            "src": "backend/backend/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb",
                "runtime": "python3.12"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "backend/staticfiles_build/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "backend/backend/wsgi.py"
        }
    ],
    "env": {
        "PYTHONPATH": "backend"
    }
}